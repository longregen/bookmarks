# Server configuration
PORT=3000

# WebAuthn configuration
# RP_ID must match your domain (without protocol)
RP_ID=localhost
RP_NAME=Bookmark RAG

# Origin must match where your extension/web app runs from
# For Chrome extension: chrome-extension://YOUR_EXTENSION_ID
# For web: http://localhost:5173 (or your web app origin)
ORIGIN=http://localhost:3000

# CORS - allow requests from extension or web app
CORS_ORIGIN=*

# Database
DATABASE_PATH=./data/bookmarks.db

# OpenAI API for embeddings and Q&A generation
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
