{
  "name": "bookmark-rag-extension",
  "version": "5.0.2",
  "description": "Capture and semantically search your bookmarks using RAG",
  "type": "module",
  "scripts": {
    "dev": "npx vite --config vite.config.chrome.ts",
    "dev:chrome": "npx vite --config vite.config.chrome.ts",
    "dev:firefox": "npx vite --config vite.config.firefox.ts",
    "dev:web": "npx vite --config vite.config.web.ts",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:web": "npx vite build --config vite.config.web.ts",
    "build:chrome": "npx vite build --config vite.config.chrome.ts",
    "build:firefox": "npx vite build --config vite.config.firefox.ts",
    "preview": "npx vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm ci && npm run typecheck & npm run lint & wait",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:walkthrough": "npx tsx tests/e2e-walkthrough.test.ts",
    "test:e2e:chrome": "SKIP_FIREFOX=1 npx tsx tests/e2e-walkthrough.test.ts",
    "test:e2e:firefox": "SKIP_CHROME=1 npx tsx tests/e2e-walkthrough.test.ts",
    "test:e2e:web": "npx tsx tests/e2e-web.test.ts",
    "test:all": "npm run test:unit && npm run test:e2e:walkthrough",
    "screenshots": "npx tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.3.0",
    "dompurify": "^3.3.1",
    "marked": "^17.0.1",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@esbuild/linux-x64": "^0.27.2",
    "@eslint/js": "^9.39.2",
    "@types/chrome": "^0.1.36",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/mocker": "^4.0.18",
    "eslint": "^9.39.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^28.0.0",
    "puppeteer-core": "^24.36.1",
    "selenium-webdriver": "^4.40.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
